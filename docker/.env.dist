# The sources' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnilab sources` says what is installed and configured.

# Where the sources' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNILAB_PLUGINS=../..

# A contact address, sent in the User-Agent: whom a service writes to before
# it blocks a caller (NCBI asks it of PubChem's heavy users).
OMNILAB_MAILTO=support@glitchr.io

# Wikidata: the language of labels, descriptions and aliases (en by default).
WIKIDATA_LANGUAGE=

# The Copernicus data stores (climate, atmosphere): an account's personal access token,
# only to submit requests; reading their catalogues needs none.
CDS_KEY=
ADS_KEY=

# NASA Earthdata: an Earthdata Login token, only to download files.
EARTHDATA_TOKEN=

# iNaturalist: the language of common names (en by default).
INATURALIST_LOCALE=

# NCBI: an API key (account settings at ncbi.nlm.nih.gov) raises its limit
# from three calls a second to ten; none is needed.
NCBI_API_KEY=

# Open-Meteo: no key needed for non-commercial use; a commercial key sends the
# calls to customer-api.open-meteo.com. A self-hosted instance: its base URI.
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URI=

# USGS Water Data: an api.data.gov key (api.waterdata.usgs.gov/signup) raises
# its rate limit; none is needed.
USGS_WATER_API_KEY=

# OpenAQ: a key is required (explore.openaq.org/register); without one the
# openaq source is left unconfigured.
OPENAQ_API_KEY=

# eBird: the user's eBird API key (ebird.org/api/keygen, with an eBird account,
# under the eBird API terms); without it the ebird source reads the taxonomy only.
EBIRD_API_KEY=

# IUCN Red List: the user's API token (an account at api.iucnredlist.org, under
# the Red List's terms of use); without it the iucn source is left unconfigured.
IUCN_API_KEY=
