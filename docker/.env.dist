# The sources' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnilab sources` says what is installed and configured.

# Where the sources' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNILAB_PLUGINS=../..

# A contact address, sent in the User-Agent: whom a service writes to before
# it blocks a caller (NCBI asks it of PubChem's heavy users).
OMNILAB_MAILTO=support@glitchr.io

# Wikidata: the language of labels, descriptions and aliases (en by default).
WIKIDATA_LANGUAGE=

# NCBI: an API key (account settings at ncbi.nlm.nih.gov) raises its limit
# from three calls a second to ten; none is needed.
NCBI_API_KEY=

# Open-Meteo: no key needed for non-commercial use; a commercial key sends the
# calls to customer-api.open-meteo.com. A self-hosted instance: its base URI.
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URI=
